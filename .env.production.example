# Copier en .env.production sur le serveur (jamais dans Git) et compléter.
POSTGRES_PASSWORD=remplacer-par-un-secret-long-et-aleatoire

# Domaine servi en HTTPS par le proxy intégré (profil https)
DOMAIN=kompri.example.fr

# Adresse publique et e-mails (obligatoires en production)
WEB_URL=https://kompri.example.fr
MAIL_TRANSPORT=smtp
SMTP_URL=smtps://utilisateur:motdepasse@smtp.example.fr:465
MAIL_FROM=Kompri <no-reply@kompri.example.fr>

# Oral et comptes (INACTIVE_ACCOUNT_DAYS active la purge des comptes inactifs)
REVIEW_WINDOW_DAYS=30
REMINDER_DAYS=14
INACTIVE_ACCOUNT_DAYS=730
ORAL_QUESTION_COUNT=3
ORAL_ANSWER_SECONDS=240
ORAL_LIMIT_PER_WINDOW=5
ORAL_WINDOW_HOURS=24
VALIDATION_DAYS=180
SESSION_DAYS=30

# Modèles : voir .env.example pour toutes les options. Tarifs en dollars par million de
# jetons, tels que publiés par le fournisseur (ici Claude Sonnet 5.5, retenu d’après
# docs/evaluations.md ; claude-opus-5-5 coûte 4 et 20).
LLM_EXAMINER_PROVIDER=anthropic
LLM_EXAMINER_MODEL=claude-sonnet-5-5
LLM_EXAMINER_INPUT_USD_PER_MILLION=2
LLM_EXAMINER_OUTPUT_USD_PER_MILLION=10
# Profondeur de réflexion de Claude (low, medium, high, xhigh, max).
ANTHROPIC_EFFORT=medium
LLM_TUTOR_PROVIDER=anthropic
LLM_TUTOR_MODEL=claude-sonnet-5-5
LLM_TUTOR_INPUT_USD_PER_MILLION=2
LLM_TUTOR_OUTPUT_USD_PER_MILLION=10
LLM_CONTENT_GENERATION_PROVIDER=mock
# Délai maximal d’un appel ; une notation mesurée prend moins de 10 s. Au-delà de 60 s, une
# étape d’oral peut dépasser le délai d’attente du serveur web (180 s).
LLM_TIMEOUT_SECONDS=60
# Nouvelles tentatives après une erreur passagère du fournisseur (surcharge, réseau), 0 à 5.
LLM_MAX_RETRIES=2
ANTHROPIC_API_KEY=remplacer
# Plafond de dépense IA estimée par mois civil (UTC), en dollars. Atteint, il suspend les
# nouveaux oraux et le tuteur jusqu’au mois suivant ; un oral commencé va à son terme.
# 20 $ restent sous 20 € tant que l’euro vaut plus qu’un dollar.
LLM_MONTHLY_BUDGET_USD=20
