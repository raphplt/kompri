# Configuration locale uniquement, copiée dans .env par pnpm install si absent.
# Les variables du processus priment sur .env. Ne jamais committer .env.
DATABASE_URL=postgresql://kompri:kompri_local@localhost:54329/kompri?schema=public
API_PORT=3001
API_URL=http://localhost:3001
# Chaque usage choisit indépendamment son fournisseur : mock ou mistral.
LLM_EXAMINER_PROVIDER=mock
LLM_TUTOR_PROVIDER=mock
LLM_CONTENT_GENERATION_PROVIDER=mock
# Pour mistral, fournir explicitement le modèle de chaque usage activé.
# LLM_EXAMINER_MODEL=identifiant-du-modele
# LLM_TUTOR_MODEL=identifiant-du-modele
# LLM_CONTENT_GENERATION_MODEL=identifiant-du-modele
# Paramètres obligatoires lorsqu'au moins un usage emploie mistral.
# URL de base compatible avec /chat/completions, hébergement configurable.
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=secret-local
# Tarifs USD par million de tokens : renseigner les tarifs du modèle choisi.
# LLM_INPUT_USD_PER_MILLION=0.0
# LLM_OUTPUT_USD_PER_MILLION=0.0
