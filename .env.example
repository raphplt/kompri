# Configuration locale uniquement, copiée dans .env par pnpm install si absent.
# Les variables du processus priment sur .env. Ne jamais committer .env.
DATABASE_URL=postgresql://kompri:kompri_local@localhost:54329/kompri?schema=public
API_PORT=3001
API_URL=http://localhost:3001

# Oral : questions, secondes par réponse, quota par fenêtre glissante, validité.
# ORAL_QUESTION_COUNT=3
# ORAL_ANSWER_SECONDS=240
# ORAL_LIMIT_PER_WINDOW=5
# ORAL_WINDOW_HOURS=24
# VALIDATION_DAYS=180
# SESSION_DAYS=30

# Chaque usage choisit indépendamment son fournisseur :
# mock, mistral, openai, gemini, anthropic, ollama ou openai-compatible.
LLM_EXAMINER_PROVIDER=mock
LLM_TUTOR_PROVIDER=mock
LLM_CONTENT_GENERATION_PROVIDER=mock
# Pour un fournisseur réel, le modèle de l’usage est obligatoire.
# LLM_EXAMINER_MODEL=identifiant-du-modele
# Tarifs USD par million de tokens (obligatoires sauf pour ollama).
# LLM_EXAMINER_INPUT_USD_PER_MILLION=0.0
# LLM_EXAMINER_OUTPUT_USD_PER_MILLION=0.0
# LLM_TUTOR_MODEL / LLM_TUTOR_*_USD_PER_MILLION et
# LLM_CONTENT_GENERATION_* suivent le même schéma.

# Clés par fournisseur (ne jamais les committer). Chaque fournisseur accepte aussi
# <PRÉFIXE>_BASE_URL pour changer d’endpoint, par exemple un hébergement européen.
# MISTRAL_API_KEY=...
# OPENAI_API_KEY=...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=...
# ANTHROPIC_FALLBACKS=default   # ou none pour désactiver le repli serveur
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_COMPATIBLE_BASE_URL=https://mon-serveur.example/v1
# OPENAI_COMPATIBLE_API_KEY=...
# Variables génériques de repli, si la variable propre au fournisseur est absente.
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=secret-local
# LLM_TIMEOUT_SECONDS=60
